{
  "$schema": "https://schema.management.azure.com/schemas/2019-04-01/deploymentTemplate.json#",
  "contentVersion": "1.0.0.0",
  "parameters": {
    "workspaceName": {
      "type": "string"
    },
    "alias": {
      "type": "string",
      "allowedValues": [
        "AIAgentInventory",
        "AIAgentApprovedMakers",
        "AIAgentRuntimeInventory",
        "AIAgentAllowedDestinations"
      ]
    },
    "rawContent": {
      "type": "string"
    }
  },
  "resources": [
    {
      "type": "Microsoft.OperationalInsights/workspaces/providers/watchlists",
      "apiVersion": "2024-03-01",
      "name": "[format('{0}/Microsoft.SecurityInsights/{1}', parameters('workspaceName'), parameters('alias'))]",
      "properties": {
        "displayName": "[parameters('alias')]",
        "watchlistAlias": "[parameters('alias')]",
        "provider": "Agent Under Watch (Preview)",
        "source": "Local file",
        "sourceType": "Local file",
        "description": "Customer maintained agent trust boundary. Disabled seed entries never authorize activity.",
        "itemsSearchKey": "SearchKey",
        "contentType": "text/csv",
        "numberOfLinesToSkip": 0,
        "rawContent": "[parameters('rawContent')]"
      }
    }
  ]
}
